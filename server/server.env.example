# 生产服务器会单独生成此值；不要把真实令牌提交到 Git。
MOVETOPLAY_API_TOKEN=replace-with-a-random-secret
# 每次玩家训练都只叠加到这个只读官方数据集，避免玩家历史数据被重复合并。
MOVETOPLAY_OFFICIAL_DATASET_ID=replace-with-ready-official-dataset-id

# 可选：配置后，确认采用模型会自动把完整模型包备份到 OSS。
# ECS 与 Bucket 同地域时优先填写内网 Endpoint，密钥只保存在服务器 server.env。
MOVETOPLAY_OSS_REGION=cn-hangzhou
MOVETOPLAY_OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
MOVETOPLAY_OSS_BUCKET=replace-with-your-private-bucket
MOVETOPLAY_OSS_PREFIX=movetoplay/models
OSS_ACCESS_KEY_ID=replace-with-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret

# 旧任务本地清理：已批准模型永久保留；其余任务按状态清理可重建产物。
MOVETOPLAY_CLEANUP_FAILED_DAYS=7
MOVETOPLAY_CLEANUP_VALIDATED_DAYS=14
MOVETOPLAY_CLEANUP_UNAPPROVED_DAYS=30
MOVETOPLAY_TRAINING_ESTIMATE_SECONDS=1500
