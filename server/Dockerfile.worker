# 与已验证的本机复现实验保持 Python 3.13.9，并固定镜像摘要。
FROM public.ecr.aws/docker/library/python:3.13.9-slim-bookworm@sha256:b685a4fa58bb19d1814d78a1ec0f0208f351452724f78b20212c984d6e124a34

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONHASHSEED=0 \
    PYTHONPATH=/workspace/server \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_DEFAULT_TIMEOUT=60 \
    PIP_RETRIES=5 \
    PIP_ROOT_USER_ACTION=ignore

WORKDIR /workspace

COPY training/requirements.txt /tmp/movetoplay-training-requirements.txt
RUN python -m pip install --no-cache-dir --requirement /tmp/movetoplay-training-requirements.txt \
    && groupadd --gid 1000 worker \
    && useradd --uid 1000 --gid worker --home-dir /workspace --no-create-home worker

COPY --chown=worker:worker . /workspace

USER worker

CMD ["python", "-m", "app.worker"]
