# 官方 ESP-IDF 自动构建镜像；摘要固定，保证云端构建环境可复现。
FROM espressif/idf:v5.5.2@sha256:88a65f412e730fdbe134cd7427dd840eb1a6923479499c9c233699f804a3096b

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONHASHSEED=0 \
    PYTHONPATH=/workspace/server \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_DEFAULT_TIMEOUT=60 \
    PIP_RETRIES=5 \
    PIP_ROOT_USER_ACTION=ignore \
    HOME=/tmp/movetoplay-worker

WORKDIR /workspace

COPY training/requirements.txt /tmp/movetoplay-training-requirements.txt
RUN python -m pip install --no-cache-dir --requirement /tmp/movetoplay-training-requirements.txt \
    && mkdir -p /tmp/movetoplay-worker \
    && chown -R 1000:1000 /tmp/movetoplay-worker

COPY --chown=1000:1000 . /workspace

USER 1000:1000

CMD ["python", "-m", "app.worker"]
