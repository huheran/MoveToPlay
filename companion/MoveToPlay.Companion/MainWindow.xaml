<Window x:Class="MoveToPlay.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MoveToPlay.Companion.Controls"
        Title="MoveToPlay Companion"
        Width="1180"
        Height="760"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF111724" />
            <Setter Property="BorderBrush" Value="#FF202A3B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="#FF081018" />
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#FFD9E2EF" />
            <Setter Property="Background" Value="#FF202A3B" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#C70B111C" />
            <Setter Property="Foreground" Value="#FFF1F5F9" />
            <Setter Property="BorderBrush" Value="#FF2B3649" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="Padding" Value="11,7" />
                        <Setter Property="Foreground" Value="#FFE5ECF5" />
                        <Setter Property="Background" Value="#FF0D1421" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="7">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#FF243148" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#FF32415C" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <Grid />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FF52617A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,38,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Path Width="9" Height="5" Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Fill="#FF8492A8" Data="M 0 0 L 9 0 L 4.5 5 Z" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        Background="#F20B111C"
                                        BorderBrush="#FF334158"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFC8D2E0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="34" Height="19" HorizontalAlignment="Left"
                                    Background="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CornerRadius="10" Opacity="0.25">
                                <Ellipse x:Name="Thumb" Width="13" Height="13" Margin="3" HorizontalAlignment="Left" Fill="#FF94A3B8" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="1" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FF081018" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="Foreground" Value="{Binding AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="{Binding ProgressCornerRadius}" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"
                                    CornerRadius="{Binding ProgressCornerRadius}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" VerticalAlignment="Center" Background="#FF273248" CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Stroke="#FF081018" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb" MinHeight="34" Background="#FF3A465A">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="1,0" Background="{TemplateBinding Background}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScrollThumb" Property="Background" Value="#FF64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainShell" Background="#ED070B12" BorderBrush="#B8324054" BorderThickness="1" CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Direction="270" Opacity="0.45" ShadowDepth="12" Color="#CC000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="24,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="40" Height="40" Background="{Binding AccentBrush}" CornerRadius="12">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Symbol"
                                   FontSize="20" FontWeight="Bold" Foreground="#FF07101A" Text="M" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="17" FontWeight="Bold" Foreground="#FFF8FAFC" Text="MoveToPlay Companion" />
                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#FF7F8CA3" Text="GAME FITNESS OVERLAY · PROTOTYPE 01" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Margin="0,0,24,0" Padding="11,6" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#2022C55E" CornerRadius="999">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{Binding ConnectionStatusBrush}" />
                        <TextBlock FontSize="11" Foreground="{Binding ConnectionStatusBrush}" Text="{Binding StatusText}" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Width="38" Height="34" Background="Transparent" BorderThickness="0" Foreground="#FFAAB5C6"
                            FontSize="18" Content="—" ToolTip="最小化窗口" Click="MinimizeButton_Click" />
                    <Button Width="38" Height="34" Background="Transparent" BorderThickness="0" Foreground="#FFAAB5C6"
                            FontSize="16" Content="×" ToolTip="隐藏到系统托盘" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20,0,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFF1F5F9" Text="设备连接" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{Binding ConnectionStatusBrush}" Text="{Binding SourceLabel}" />
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="#FFF8FAFC" Text="{Binding TrackerStatus}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#FF7F8CA3" Text="TRACKER" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="#FFF8FAFC" Text="{Binding BladeStatus}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#FF7F8CA3" Text="BLADE" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{Binding AccentBrush}" Text="{Binding SignalQuality}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="#FF7F8CA3" Text="SIGNAL" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,15,0,0" FontSize="11" Foreground="#FF7F8CA3" TextWrapping="Wrap"
                                           Text="{Binding ConnectionDetail}" />
                                <TextBlock Margin="0,13,0,7" FontSize="10" Foreground="#FF7F8CA3" Text="设备电量" />
                                <UniformGrid Columns="5">
                                    <StackPanel>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#FFF1F5F9" Text="{Binding ChestBattery}" />
                                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9"
                                                   Foreground="#FF7F8CA3" Text="胸部" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#FFF1F5F9" Text="{Binding RightHandBattery}" />
                                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9"
                                                   Foreground="#FF7F8CA3" Text="右手" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#FFF1F5F9" Text="{Binding LeftHandBattery}" />
                                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9"
                                                   Foreground="#FF7F8CA3" Text="左手" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#FFF1F5F9" Text="{Binding LegBattery}" />
                                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9"
                                                   Foreground="#FF7F8CA3" Text="腿部" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding AccentBrush}" Text="{Binding BladeBattery}" />
                                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="9"
                                                   Foreground="#FF7F8CA3" Text="BLADE" />
                                    </StackPanel>
                                </UniformGrid>
                                <Button Margin="0,16,0,0" Height="34" Style="{StaticResource GhostButton}"
                                        Content="数据采集与云端训练" Click="OpenTrainingWindow_Click" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFF1F5F9" Text="游戏定制" />
                                <TextBlock Margin="0,14,0,6" FontSize="10" Foreground="#FF7F8CA3" Text="界面主题" />
                                <ComboBox x:Name="ProfileSelector" SelectionChanged="ProfileSelector_SelectionChanged" />
                                <Grid Margin="0,12,0,6">
                                    <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#FF7F8CA3" Text="目标游戏窗口" />
                                    <Button HorizontalAlignment="Right" Padding="8,3" Background="Transparent" BorderThickness="0"
                                            Foreground="{Binding AccentBrush}" FontSize="10" Content="刷新列表" Click="RefreshWindowsButton_Click" />
                                </Grid>
                                <ComboBox x:Name="WindowSelector" SelectionChanged="WindowSelector_SelectionChanged" />
                                <CheckBox x:Name="FollowGameCheckBox" IsChecked="True" Content="悬浮层跟随游戏窗口" Checked="OverlayOptionChanged" Unchecked="OverlayOptionChanged" />
                                <CheckBox x:Name="HideInactiveCheckBox" IsChecked="True" Content="切出游戏时自动隐藏" Checked="OverlayOptionChanged" Unchecked="OverlayOptionChanged" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFF1F5F9" Text="悬浮层控制" />
                                <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="#FF68778D"
                                           Text="当前位置按游戏主题独立保存" />
                                <TextBlock Margin="0,13,0,6" FontSize="10" Foreground="#FF7F8CA3" Text="预览 / 适配分辨率" />
                                <ComboBox x:Name="OverlayResolutionSelector"
                                          SelectionChanged="OverlayResolutionSelector_SelectionChanged" />
                                <TextBlock Margin="0,13,0,6" FontSize="10" Foreground="#FF7F8CA3" Text="位置锚点" />
                                <ComboBox x:Name="OverlayAnchorSelector"
                                          SelectionChanged="OverlayAnchorSelector_SelectionChanged" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#FF8B99AE" Text="水平微调" />
                                    <Slider x:Name="OverlayOffsetXSlider" Grid.Column="1"
                                            Minimum="-800" Maximum="800" TickFrequency="10" IsSnapToTickEnabled="True"
                                            ValueChanged="OverlayOffsetSlider_ValueChanged" />
                                    <TextBlock x:Name="OverlayOffsetXText" Grid.Column="2" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontFamily="Consolas" FontSize="10"
                                               Foreground="#FFB7C3D5" Text="0" />
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="#FF8B99AE" Text="垂直微调" />
                                    <Slider x:Name="OverlayOffsetYSlider" Grid.Column="1"
                                            Minimum="-500" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True"
                                            ValueChanged="OverlayOffsetSlider_ValueChanged" />
                                    <TextBlock x:Name="OverlayOffsetYText" Grid.Column="2" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontFamily="Consolas" FontSize="10"
                                               Foreground="#FFB7C3D5" Text="0" />
                                </Grid>
                                <Button Margin="0,10,0,0" Height="32" Style="{StaticResource GhostButton}"
                                        Content="恢复当前游戏默认位置" Click="ResetOverlayPlacementButton_Click" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ToggleOverlayButton" Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                            Content="显示悬浮层" Click="ToggleOverlayButton_Click" />
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                            Content="播放激励" Click="EncouragementButton_Click" />
                                </Grid>
                                <Border Margin="0,13,0,0" Padding="11,8" Background="#FF0C121D" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#FF8FA2B9"
                                                   Text="CTRL + SHIFT + F10  显示 / 隐藏" />
                                        <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="#FF68778D"
                                                   Text="关闭主窗口后，程序会继续在系统托盘运行" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="164" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="PreviewHost" Grid.Row="0" SizeChanged="PreviewHost_SizeChanged">
                    <Border x:Name="PreviewViewport" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#FF0C121D" BorderBrush="#FF202A3B" BorderThickness="1" CornerRadius="20" ClipToBounds="True">
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FF0A2638" />
                                    <GradientStop Offset="0.48" Color="#FF152C45" />
                                    <GradientStop Offset="0.76" Color="#FF242A4A" />
                                    <GradientStop Offset="1" Color="#FF39233F" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Ellipse Width="420" Height="420" Margin="-170,-220,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Fill="{Binding AccentBrush}" Opacity="0.06" />
                            <Ellipse Width="300" Height="300" Margin="0,0,-90,-140" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Fill="{Binding AccentSecondaryBrush}" Opacity="0.08" />
                            <TextBlock x:Name="PreviewResolutionText" Margin="22,18,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       FontFamily="Consolas" FontSize="10" Foreground="#FF7D9BB6"
                                       Text="TRANSPARENT OVERLAY PREVIEW · AUTO" />
                            <TextBlock Margin="0,0,25,18" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11"
                                       Foreground="#FF5F6D82" Text="游戏画面区域" />

                            <Border x:Name="PreviewOverlayCard" Width="350" Margin="28,52,28,0" Padding="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="Transparent" BorderThickness="0">
                                <StackPanel>
                                    <StackPanel.Effect>
                                        <DropShadowEffect BlurRadius="5" Direction="0" Opacity="0.82" ShadowDepth="0" Color="#FF000000" />
                                    </StackPanel.Effect>
                                    <Border Padding="0" Background="Transparent" BorderThickness="0">
                                        <Grid>
                                            <StackPanel>
                                                <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="9" FontWeight="Bold"
                                                                       Foreground="{Binding AccentBrush}" Stroke="#EE000000" StrokeThickness="1"
                                                                       Text="{Binding ProfileSubtitle}" />
                                                <controls:OutlinedText Margin="0,1,0,0" FontFamily="{Binding HudFontFamily}" FontSize="13" FontWeight="Bold"
                                                                       Foreground="{Binding PrimaryTextBrush}" Stroke="#F5000000" StrokeThickness="1.2"
                                                                       Text="{Binding ProfileName}" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Margin="0,0,4,0" Fill="#FF6EE7B7" />
                                                <controls:OutlinedText FontFamily="Consolas" FontSize="8" FontWeight="Bold" Foreground="#FFC7FFE5"
                                                                       Stroke="#EE000000" StrokeThickness="0.9" Text="{Binding StatusText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Margin="0,12,0,0" Padding="0" Background="Transparent" BorderThickness="0">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock FontFamily="{Binding HudFontFamily}" FontSize="9"
                                                           Foreground="{Binding MutedTextBrush}" Text="{Binding ActionLabel}" />
                                                <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="27" FontWeight="Black"
                                                                       Foreground="{Binding PrimaryTextBrush}" Stroke="#FF000000" StrokeThickness="1.75"
                                                                       Text="{Binding ActionName}" />
                                                <controls:OutlinedText FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{Binding AccentSecondaryBrush}" Stroke="#F5000000" StrokeThickness="1.1"
                                                                       Text="{Binding ActionHint}" />
                                            </StackPanel>
                                            <Border Width="50" Height="50" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent"
                                                    BorderThickness="0">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{Binding HudFontFamily}"
                                                           FontSize="21" Foreground="{Binding AccentBrush}" Text="{Binding MarkerGlyph}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Padding="0" Background="Transparent" BorderThickness="0">
                                            <StackPanel>
                                                <TextBlock FontFamily="{Binding HudFontFamily}" FontSize="8" Foreground="{Binding MutedTextBrush}" Text="运动后心率" />
                                                <controls:OutlinedText Margin="0,1,0,0" FontFamily="{Binding HudFontFamily}" FontSize="17" FontWeight="Black"
                                                                       Foreground="{Binding PrimaryTextBrush}" Stroke="#FF000000" StrokeThickness="1.35"
                                                                       Text="{Binding HeartRate, StringFormat={}{0} BPM}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0">
                                            <StackPanel>
                                                <TextBlock FontFamily="{Binding HudFontFamily}" FontSize="8" Foreground="{Binding MutedTextBrush}" Text="消耗" />
                                                <controls:OutlinedText Margin="0,1,0,0" FontFamily="{Binding HudFontFamily}" FontSize="17" FontWeight="Black"
                                                                       Foreground="{Binding PrimaryTextBrush}" Stroke="#FF000000" StrokeThickness="1.35"
                                                                       Text="{Binding Calories, StringFormat={}{0} kcal}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Padding="0" Background="Transparent" BorderThickness="0">
                                            <StackPanel>
                                                <TextBlock FontFamily="{Binding HudFontFamily}" FontSize="8" Foreground="{Binding MutedTextBrush}" Text="运动" />
                                                <controls:OutlinedText Margin="0,1,0,0" FontFamily="{Binding HudFontFamily}" FontSize="17" FontWeight="Black"
                                                                       Foreground="{Binding PrimaryTextBrush}" Stroke="#FF000000" StrokeThickness="1.35"
                                                                       Text="{Binding ActiveTime}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Margin="0,12,0,0" Padding="0" Background="Transparent" BorderThickness="0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock FontFamily="{Binding HudFontFamily}" FontSize="8"
                                                           Foreground="{Binding MutedTextBrush}" Text="{Binding GoalLabel}" />
                                                <TextBlock HorizontalAlignment="Right" FontFamily="Consolas" FontSize="8" Foreground="{Binding AccentBrush}"
                                                           Text="{Binding GoalProgress, StringFormat={}{0}%}" />
                                            </Grid>
                                            <ProgressBar Height="{Binding ProgressHeight}" Margin="0,6,0,0" Maximum="100" Value="{Binding GoalProgress, Mode=OneWay}"
                                                         Foreground="{Binding AccentBrush}" Background="#32FFFFFF" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border x:Name="PreviewToast" MaxWidth="390" Margin="32,62,0,0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="Transparent" BorderThickness="0" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" Direction="0" Opacity="0.88" ShadowDepth="0" Color="#FF000000" />
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" FontFamily="{Binding HudFontFamily}"
                                               Foreground="{Binding AccentBrush}" Text="{Binding MarkerGlyph}" />
                                    <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="12" FontWeight="Black"
                                                           Foreground="{Binding PrimaryTextBrush}" Stroke="#FF000000" StrokeThickness="1.25"
                                                           Text="{Binding Encouragement}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock FontSize="10" Foreground="#FF7F8CA3" Text="运动后心率" />
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <TextBlock FontSize="31" FontWeight="Bold" Foreground="#FFFF7690" Text="{Binding HeartRate}" />
                                    <TextBlock Margin="5,13,0,0" FontSize="10" Foreground="#FF7F8CA3" Text="BPM" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="#FF9AA8BA" Text="本次运动结束后静止测量" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock FontSize="10" Foreground="#FF7F8CA3" Text="估算消耗" />
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <TextBlock FontSize="31" FontWeight="Bold" Foreground="{Binding AccentBrush}" Text="{Binding Calories}" />
                                    <TextBlock Margin="5,13,0,0" FontSize="10" Foreground="#FF7F8CA3" Text="KCAL" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="#FF9AA8BA" Text="根据动作强度与 MET 估算" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock FontSize="10" Foreground="#FF7F8CA3" Text="连续动作" />
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <TextBlock FontSize="31" FontWeight="Bold" Foreground="{Binding AccentSecondaryBrush}" Text="{Binding Combo}" />
                                    <TextBlock Margin="5,13,0,0" FontSize="10" Foreground="#FF7F8CA3" Text="COMBO" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="#FF9AA8BA" Text="继续运动以维持连击" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
