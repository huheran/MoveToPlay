<Window x:Class="MoveToPlay.Companion.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MoveToPlay.Companion.Controls"
        Title="MoveToPlay Overlay"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False">
    <Window.SnapsToDevicePixels>True</Window.SnapsToDevicePixels>
    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="{Binding ProgressCornerRadius}" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="{Binding ProgressCornerRadius}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- The HWND, HUD gaps and text backgrounds are all fully transparent. -->
    <Grid x:Name="OverlayRoot" Background="Transparent" IsHitTestVisible="False">
        <Border x:Name="OverlayCard"
                Width="410"
                Margin="38"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0">
            <StackPanel>
                <StackPanel.Effect>
                    <DropShadowEffect BlurRadius="6" Direction="0" Opacity="0.82" ShadowDepth="0" Color="#FF000000" />
                </StackPanel.Effect>

                <Grid x:Name="HeaderTextGroup">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="12" FontWeight="Bold"
                                               Foreground="{Binding AccentBrush}" Stroke="#FF000000" StrokeThickness="1.55"
                                               Text="{Binding ProfileSubtitle}" />
                        <controls:OutlinedText Margin="0,1,0,0" FontFamily="{Binding HudFontFamily}" FontSize="17" FontWeight="Bold"
                                               Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.65"
                                               Text="{Binding ProfileName}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="#FF6EE7B7" />
                        <controls:OutlinedText FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#FFFFFFFF"
                                               Stroke="#FF000000" StrokeThickness="1.45" Text="{Binding StatusText}" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ActionTextGroup" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.55"
                                               Text="{Binding ActionLabel}" />
                        <controls:OutlinedText Margin="0,0,0,0" FontFamily="{Binding HudFontFamily}" FontSize="36" FontWeight="Black"
                                               Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="2.35"
                                               Text="{Binding ActionName}" />
                        <controls:OutlinedText Margin="0,1,0,0" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                               Foreground="{Binding AccentSecondaryBrush}" Stroke="#FF000000" StrokeThickness="1.55"
                                               Text="{Binding ActionHint}" />
                    </StackPanel>
                    <controls:OutlinedText Grid.Column="1" Margin="0,8,6,0" VerticalAlignment="Center" FontSize="34"
                                           FontFamily="{Binding HudFontFamily}" Foreground="{Binding AccentBrush}"
                                           Stroke="#FF000000" StrokeThickness="2.0" Text="{Binding MarkerGlyph}" />
                </Grid>

                <Grid x:Name="MetricsTextGroup" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.45"
                                               Text="运动后心率" />
                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                            <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="23" FontWeight="Black"
                                                   Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.85"
                                                   Text="{Binding HeartRate}" />
                            <controls:OutlinedText Margin="4,8,0,0" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                   Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.3"
                                                   Text="BPM" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.45"
                                               Text="消耗" />
                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                            <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="23" FontWeight="Black"
                                                   Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.85"
                                                   Text="{Binding Calories}" />
                            <controls:OutlinedText Margin="4,8,0,0" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                   Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.3"
                                                   Text="KCAL" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.45"
                                               Text="运动" />
                        <controls:OutlinedText Margin="0,2,0,0" FontFamily="{Binding HudFontFamily}" FontSize="23" FontWeight="Black"
                                               Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.85"
                                               Text="{Binding ActiveTime}" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="GoalTextGroup" Margin="0,17,4,0">
                    <Grid>
                        <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.45"
                                               Text="{Binding GoalLabel}" />
                        <controls:OutlinedText HorizontalAlignment="Right" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding AccentBrush}" Stroke="#FF000000" StrokeThickness="1.45"
                                               Text="{Binding GoalProgress, StringFormat={}{0}%}" />
                    </Grid>
                    <ProgressBar Height="{Binding ProgressHeight}" Margin="0,7,0,0" Maximum="100" Value="{Binding GoalProgress, Mode=OneWay}"
                                 Foreground="{Binding AccentBrush}" Background="#55FFFFFF" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="EncouragementToast"
                MaxWidth="720"
                Margin="0,72,0,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="7" Direction="0" Opacity="0.88" ShadowDepth="0" Color="#FF000000" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="-18" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <controls:OutlinedText Margin="0,0,10,0" FontFamily="{Binding HudFontFamily}" FontSize="19"
                                       Foreground="{Binding AccentBrush}" Stroke="#FF000000" StrokeThickness="1.5"
                                       Text="{Binding MarkerGlyph}" />
                <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="18" FontWeight="Black"
                                       Foreground="{Binding AccentBrush}" Stroke="#FF000000" StrokeThickness="1.9"
                                       Text="{Binding ToastActionName}" />
                <controls:OutlinedText Margin="8,0,8,0" FontFamily="{Binding HudFontFamily}" FontSize="18" FontWeight="Black"
                                       Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.9" Text="·" />
                <controls:OutlinedText FontFamily="{Binding HudFontFamily}" FontSize="18" FontWeight="Black"
                                       Foreground="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.9"
                                       Text="{Binding ToastMessage}" />
                <controls:OutlinedText Margin="16,1,0,0" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                       Foreground="{Binding AccentSecondaryBrush}" Stroke="#F5000000" StrokeThickness="1.25"
                                       Text="{Binding ToastComboDisplay}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
