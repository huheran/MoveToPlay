<Window x:Class="MoveToPlay.Companion.TrainingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoveToPlay · 数据采集与云端训练"
        Width="1180" Height="800" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="#FF080D15"
        Foreground="#FFE7EDF7" FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE7EDF7" />
        </Style>
        <DataTemplate x:Key="ComboBoxTextTemplate">
            <TextBlock Foreground="#FF172033" Text="{Binding}" />
        </DataTemplate>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF111925" />
            <Setter Property="BorderBrush" Value="#FF263246" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="#FF233149" />
            <Setter Property="Foreground" Value="#FFF2F6FC" />
            <Setter Property="BorderBrush" Value="#FF354660" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF2DD4BF" />
            <Setter Property="Foreground" Value="#FF06131A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="ItemTemplate" Value="{StaticResource ComboBoxTextTemplate}" />
            <Setter Property="Background" Value="#FF0B121E" />
            <Setter Property="Foreground" Value="#FF172033" />
            <Setter Property="BorderBrush" Value="#FF64748B" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="#FF0B121E" />
            <Setter Property="Foreground" Value="#FFF2F6FC" />
            <Setter Property="BorderBrush" Value="#FF354660" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="23" FontWeight="Bold" Text="数据采集与云端训练" />
                <TextBlock Margin="0,6,0,0" Foreground="#FF8291A7"
                           Text="Dongle 采集态 → 标注 CSV → SSH 安全上传 → 双随机森林 → C 数组" />
            </StackPanel>
            <Border Grid.Column="1" Padding="13,7" Background="#FF111925" CornerRadius="999" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="CloudStatusDot" Width="8" Height="8" Margin="0,0,8,0" Fill="#FF64748B" />
                    <TextBlock x:Name="CloudStatusText" FontSize="11" Text="云端未连接" />
                </StackPanel>
            </Border>
        </Grid>

        <TabControl x:Name="TrainingTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="#FFF1F5F9">
            <TabItem Header="  1. 采集与标注  ">
                <Border Margin="0,14,0,0" Style="{StaticResource Card}" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="940" HorizontalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="一次采集的设置与标注" />
                            <TextBlock Margin="0,7,0,16" Foreground="#FF8291A7" TextWrapping="Wrap"
                                       Text="按顺序完成下面的选择，最后再开始采集。Dongle 需长按按钮 2 秒进入橙灯采集态。" />

                            <Border Padding="16" Background="#FF0A111C" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="1　连接 Dongle" />
                                    <TextBlock Margin="0,10,0,6" Foreground="#FF93A3B8" Text="Dongle 串口" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="PortSelector" SelectionChanged="CollectionSelection_Changed" />
                                        <Button Grid.Column="1" Margin="9,0,0,0" Content="刷新串口" Click="RefreshPorts_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="16" Background="#FF0A111C" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="2　选择训练标签" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,6" Foreground="#FF93A3B8" Text="连续状态标签" />
                                            <ComboBox x:Name="StateLabelSelector" SelectionChanged="StateLabelSelector_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,6" Foreground="#FF93A3B8" Text="本次单独动作标签" />
                                            <ComboBox x:Name="EventSelector" SelectionChanged="EventSelector_SelectionChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="16" Background="#FF0A111C" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="3　选择标记方式" />
                                    <TextBlock Margin="0,10,0,6" Foreground="#FF93A3B8" Text="Blade 标记方式" />
                                    <ComboBox x:Name="BladeModeSelector" SelectionChanged="BladeModeSelector_SelectionChanged" />
                                    <StackPanel x:Name="BladeCountdownPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Margin="0,0,0,6" Foreground="#FF93A3B8" Text="每次固定倒计时（毫秒）" />
                                                <TextBox x:Name="BladeCountdownText" IsReadOnly="True" Text="5000" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Margin="0,0,0,6" Foreground="#FF93A3B8" Text="计划采集次数" />
                                                <TextBox x:Name="BladeTargetCountText" Text="30" LostFocus="BladeSettings_Changed" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="#FF8291A7"
                                                   Text="开始采集后自动循环，无需按 Blade；每次归零后 0.5 秒写入标签。" />
                                    </StackPanel>
                                    <StackPanel x:Name="BladeCompensationPanel" Margin="0,10,0,0">
                                        <TextBlock Margin="0,0,0,6" Foreground="#FF93A3B8" Text="即时延迟补偿（毫秒）" />
                                        <TextBox x:Name="BladeCompensationText" Text="50" LostFocus="BladeSettings_Changed" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="16" Background="#FF0A111C" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="4　确认保存位置" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="CollectionRootText" IsReadOnly="True" />
                                        <Button Grid.Column="1" Margin="9,0,0,0" Content="选择位置" Click="ChooseCollectionRoot_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0" Padding="16" Background="#172DD4BF" BorderBrush="#552DD4BF"
                                    BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="5　开始采集" />
                                        <TextBlock x:Name="CollectionModeHelpText" Margin="0,5,0,0" Foreground="#FF9BE7DB" TextWrapping="Wrap"
                                                   Text="采集期间按一次 Blade 生成一个所选动作标签；电脑按钮可作备用触发。" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="StartCollectionButton" MinWidth="128" MinHeight="44" Style="{StaticResource Primary}"
                                                IsEnabled="False" Content="开始采集" Click="StartCollection_Click" />
                                        <Button x:Name="StopCollectionButton" MinHeight="44" IsEnabled="False"
                                                Content="停止并保存" Click="StopCollection_Click" />
                                        <Button x:Name="ManualMarkButton" MinHeight="44" Content="电脑按钮触发一次" Click="MarkSelectedEvent_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="13" Background="#FF0A111C" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock x:Name="CollectionStatusText" Text="请按顺序完成采集设置" TextWrapping="Wrap" />
                                    <Grid Margin="0,7,0,0">
                                        <TextBlock x:Name="SampleCountText" VerticalAlignment="Center" FontFamily="Consolas"
                                                   Foreground="#FF2DD4BF" Text="样本 0 · Tracker 0/4 · Blade 离线" />
                                        <Button HorizontalAlignment="Right" Padding="10,3" Content="刷新设备状态"
                                                Click="RefreshCollectionStatus_Click" />
                                    </Grid>
                                    <TextBlock x:Name="CollectionFilesText" Margin="0,7,0,0" FontSize="10"
                                               Foreground="#FF718096" Text="尚未生成文件" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Expander Margin="0,12,0,0" Header="动作标签库管理（新增、修改、恢复）">
                                <Border Margin="0,8,0,0" Padding="16" Background="#FF0A111C" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Foreground="#FF8291A7" TextWrapping="Wrap"
                                                   Text="删除动作只会影响本机选择列表，不会删除已经采集的 CSV。误删官方动作可直接恢复。" />
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Button Content="＋ 新建动作" Click="NewEventOption_Click" />
                                            <Button Content="恢复缺失的官方动作" Click="RestoreDefaultEvents_Click" />
                                        </StackPanel>
                                        <TextBlock Margin="0,10,0,5" Foreground="#FF93A3B8" Text="显示名称" />
                                        <TextBox x:Name="EventDisplayNameText" />
                                        <TextBlock Margin="0,9,0,5" Foreground="#FF93A3B8" Text="系统动作编号（自动生成）" />
                                        <TextBox x:Name="EventTypeText" IsReadOnly="True" />
                                        <StackPanel Margin="0,13,0,0" Orientation="Horizontal">
                                            <Button x:Name="SaveEventOptionButton" Style="{StaticResource Primary}"
                                                    Content="保存修改" Click="SaveEventOption_Click" />
                                            <Button x:Name="DeleteEventOptionButton" Content="仅从动作列表移除"
                                                    ToolTip="不会删除已经采集的 CSV、云端数据或训练模型"
                                                    Click="DeleteEventOption_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="  2. 我的采集数据  ">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="我的采集数据" />
                                <TextBlock Margin="0,7,0,0" Foreground="#FF8291A7" TextWrapping="Wrap"
                                           Text="每一行代表一次独立采集。勾选任意历史会话后合并进入训练；删除只影响本机所选会话，不会修改官方基础数据。" />
                                <TextBlock x:Name="CollectionLibraryRootText" Margin="0,7,0,0" FontSize="10"
                                           Foreground="#FF718096" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Content="刷新列表" Click="RefreshCollectionLibrary_Click" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                        <ListBox x:Name="CollectionSessionList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" Background="#FF0A111C" BorderBrush="#FF263246"
                                            BorderThickness="1" CornerRadius="9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding CreatedDisplay}" />
                                                <TextBlock Margin="0,4,0,0" FontFamily="Consolas" FontSize="10"
                                                           Foreground="#FF718096" Text="{Binding SessionId}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="{Binding ActionsDisplay}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#FF8291A7"
                                                           Text="{Binding CountsDisplay}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="#FF8291A7"
                                                       Text="{Binding SizeDisplay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Grid.Row="3" Margin="0,12,0,0" Padding="14" Background="#FF111925"
                            BorderBrush="#FF263246" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CollectionLibraryStatusText" Text="等待读取采集数据" TextWrapping="Wrap" />
                                <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                    <Button Content="全选" Click="SelectAllCollections_Click" />
                                    <Button Content="清除选择" Click="ClearCollectionSelection_Click" />
                                    <Button Content="删除选中的本地数据" Click="DeleteSelectedCollections_Click" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Primary}" VerticalAlignment="Center"
                                    Content="使用选中数据进入训练 →" Click="PrepareSelectedCollections_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="  3. 云端训练  ">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.95*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="数据集与连接" />
                            <TextBlock Margin="0,7,0,16" Foreground="#FF8291A7" TextWrapping="Wrap"
                                       Text="无需域名。软件使用 SSH 配置 movetoplay-server 建立加密隧道，训练 API 仍只监听服务器本机。" />
                            <Button x:Name="ConnectCloudButton" Style="{StaticResource Primary}" HorizontalAlignment="Left"
                                    Content="连接阿里云服务器" Click="ConnectCloud_Click" />
                            <TextBlock Margin="0,10,0,0" Foreground="#FF2DD4BF" TextWrapping="Wrap"
                                       Text="训练文件由“我的采集数据”页面生成，避免误传或漏传历史会话。" />
                            <TextBlock Margin="0,14,0,6" Foreground="#FF93A3B8" Text="samples.csv" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="SamplesPathText" IsReadOnly="True" />
                            </Grid>
                            <TextBlock Margin="0,12,0,6" Foreground="#FF93A3B8" Text="events.csv" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="EventsPathText" IsReadOnly="True" />
                            </Grid>
                            <TextBlock Margin="0,12,0,6" Foreground="#FF93A3B8" Text="数据集名称" />
                            <TextBox x:Name="DatasetNameText" Text="决赛演示采集" />
                            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                                <Button x:Name="TrainButton" Style="{StaticResource Primary}" IsEnabled="False"
                                        Content="上传并开始训练" Click="Train_Click" />
                                <Button x:Name="CancelTaskButton" IsEnabled="False" Content="停止等待" Click="CancelTask_Click" />
                            </StackPanel>
                            <ProgressBar x:Name="UploadProgress" Margin="0,7,0,0" Height="8" Minimum="0" Maximum="100" />
                            <TextBlock x:Name="UploadProgressText" Margin="0,8,0,0" Foreground="#FF8291A7" Text="尚未上传" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="训练结果与模型产物" />
                                <TextBlock x:Name="JobIdentityText" Margin="0,7,0,0" FontFamily="Consolas"
                                           Foreground="#FF8291A7" Text="JOB —" TextWrapping="Wrap" />
                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExistingJobIdText" ToolTip="输入服务器 Job ID，或使用自动保存的上次任务" />
                                    <Button Grid.Column="1" Margin="9,0,0,0" Content="加载任务" Click="LoadExistingJob_Click" />
                                </Grid>
                            </StackPanel>
                            <Border Grid.Row="1" Margin="0,15,0,12" Padding="13" Background="#FF0A111C" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock x:Name="JobStatusText" FontSize="15" FontWeight="SemiBold" Text="等待训练任务" />
                                    <TextBlock x:Name="TrainingStageText" Margin="0,7,0,0" Foreground="#FF2DD4BF"
                                               Text="尚未开始" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="TrainingProgress" Margin="0,9,0,0" Height="9"
                                                 Minimum="0" Maximum="100" Value="0" />
                                    <Grid Margin="0,7,0,0">
                                        <TextBlock x:Name="TrainingProgressText" Foreground="#FF93A3B8" Text="0%" />
                                        <TextBlock x:Name="TrainingTimeText" HorizontalAlignment="Right"
                                                   Foreground="#FF93A3B8" Text="已用 00:00 · 剩余 —" />
                                    </Grid>
                                    <TextBlock x:Name="MetricsText" Margin="0,8,0,0" Foreground="#FFB5C2D4"
                                               Text="完成后显示 State RF / Event RF 准确率与质量门禁" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="ArtifactList" Grid.Row="2" Background="#FF0A111C" Foreground="#FFD7E1EF"
                                     BorderBrush="#FF263246" FontFamily="Consolas" FontSize="11" />
                            <StackPanel Grid.Row="3" Margin="0,13,0,0" Orientation="Horizontal">
                                <Button x:Name="DownloadArtifactsButton" IsEnabled="False" Content="下载全部产物" Click="DownloadArtifacts_Click" />
                                <Button x:Name="ApproveButton" IsEnabled="False" Style="{StaticResource Primary}"
                                        Content="确认采用本次模型" Click="Approve_Click" />
                            </StackPanel>
                            <Border Grid.Row="4" Margin="0,10,0,0" Padding="12" Background="#FF0A111C"
                                    BorderBrush="#FF263246" BorderThickness="1" CornerRadius="9">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="更新 Dongle 模型固件" />
                                    <TextBlock Margin="0,5,0,8" FontSize="10" Foreground="#FF8291A7" TextWrapping="Wrap"
                                               Text="先确认采用模型并生成固件；再让 Dongle 进入蓝灯维护模式，选择其烧录串口。" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="FirmwarePortSelector" SelectionChanged="FirmwarePortSelector_SelectionChanged" />
                                        <Button Grid.Column="1" Margin="9,0,0,0" Content="刷新串口" Click="RefreshFirmwarePorts_Click" />
                                    </Grid>
                                    <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                        <Button x:Name="BuildFirmwareButton" IsEnabled="False"
                                                Content="1. 生成 Dongle 固件" Click="BuildFirmware_Click" />
                                        <Button x:Name="FlashFirmwareButton" IsEnabled="False" Style="{StaticResource Primary}"
                                                Content="2. 烧录到 Dongle" Click="FlashFirmware_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="FirmwareStatusText" Margin="0,5,0,0" FontSize="10"
                                               Foreground="#FF9BE7DB" Text="等待已批准模型" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="FirmwareProgress" Margin="0,8,0,0" Height="7"
                                                 Minimum="0" Maximum="100" Value="0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="  4. 模型版本库  ">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="模型版本库与历史任务" />
                                <TextBlock Margin="0,6,0,0" Foreground="#FF8291A7" TextWrapping="Wrap"
                                           Text="已批准模型永久保留并可重新生成固件；未批准旧任务按服务器清理规则自动整理。" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="RefreshHistoryButton" VerticalAlignment="Center"
                                    Style="{StaticResource Primary}" Content="刷新云端列表" Click="RefreshHistory_Click" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="历史训练任务" />
                                    <TextBlock x:Name="HistoryStatusText" Margin="0,5,0,10" Foreground="#FF8291A7"
                                               Text="连接服务器后显示全部任务" />
                                </StackPanel>
                                <ListBox x:Name="JobHistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                         SelectionChanged="JobHistoryList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Margin" Value="0,0,0,7" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="11" Background="#FF0A111C" BorderBrush="#FF263246" BorderThickness="1" CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding CreatedDisplay}" />
                                                        <TextBlock Margin="0,4,0,0" FontSize="10" FontFamily="Consolas" Foreground="#FF718096" Text="{Binding Id}" />
                                                        <TextBlock Margin="0,5,0,0" Foreground="#FF9BE7DB" Text="{Binding ProgressDisplay}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top"
                                                               Foreground="#FFB5C2D4" Text="{Binding StatusDisplay}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="2" x:Name="LoadHistoryJobButton" IsEnabled="False"
                                        Content="加载所选任务详情" Click="LoadSelectedHistoryJob_Click" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="已批准模型版本" />
                                    <TextBlock Margin="0,5,0,10" Foreground="#FF8291A7"
                                               Text="选择任意历史版本，可重新生成固件或烧录回滚。" />
                                </StackPanel>
                                <ListBox x:Name="ModelVersionList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                         SelectionChanged="ModelVersionList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Margin" Value="0,0,0,7" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="11" Background="#FF0A111C" BorderBrush="#FF263246" BorderThickness="1" CornerRadius="9">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock FontWeight="SemiBold" Foreground="#FF2DD4BF" Text="{Binding VersionDisplay}" />
                                                        <TextBlock HorizontalAlignment="Right" Foreground="#FFFFC857" Text="{Binding ActiveDisplay}" />
                                                    </Grid>
                                                    <TextBlock Margin="0,5,0,0" Text="{Binding CreatedDisplay}" />
                                                    <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#FF93A3B8" Text="{Binding BackupDisplay}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="RollbackPortSelector" SelectionChanged="RollbackPortSelector_SelectionChanged" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Content="刷新串口" Click="RefreshRollbackPorts_Click" />
                                    </Grid>
                                    <WrapPanel Margin="0,9,0,0">
                                        <Button x:Name="LoadModelVersionButton" IsEnabled="False"
                                                Content="选择此模型" Click="LoadSelectedModel_Click" />
                                        <Button x:Name="RebuildModelFirmwareButton" IsEnabled="False"
                                                Content="重新生成固件" Click="RebuildSelectedModel_Click" />
                                        <Button x:Name="RollbackModelButton" IsEnabled="False" Style="{StaticResource Primary}"
                                                Content="一键回滚并烧录" Click="RollbackSelectedModel_Click" />
                                    </WrapPanel>
                                    <ProgressBar x:Name="RollbackProgress" Margin="0,5,0,0" Height="7" Minimum="0" Maximum="100" />
                                    <TextBlock x:Name="RollbackStatusText" Margin="0,6,0,0" FontSize="10"
                                               Foreground="#FF9BE7DB" Text="请选择历史模型和蓝灯 Dongle 串口" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
