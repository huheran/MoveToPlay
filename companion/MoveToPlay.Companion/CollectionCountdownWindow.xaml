<Window x:Class="MoveToPlay.Companion.CollectionCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="360" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Border x:Name="CountdownCard" Padding="30" Background="#F20A111C"
            BorderBrush="#FF2DD4BF" BorderThickness="3" CornerRadius="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ActionNameText" HorizontalAlignment="Center"
                       FontSize="25" FontWeight="SemiBold" Foreground="#FFF2F6FC" />
            <TextBlock x:Name="CountdownText" Grid.Row="1" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="138" FontWeight="Bold"
                       Foreground="#FF2DD4BF" Text="5" />
            <TextBlock x:Name="HintText" Grid.Row="2" HorizontalAlignment="Center"
                       FontSize="20" FontWeight="SemiBold" Foreground="#FFB5C2D4"
                       Text="准备动作" />
        </Grid>
    </Border>
</Window>
